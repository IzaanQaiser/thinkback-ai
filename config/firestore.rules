rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User's saved content - only the owner can access
    match /users/{userId}/saved_content/{contentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User's feedback - only the owner can access
    match /users/{userId}/feedback/{feedbackId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User's settings - only the owner can access
    match /users/{userId}/settings/{settingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Global content (if any) - read-only for authenticated users
    match /global_content/{contentId} {
      allow read: if request.auth != null;
      allow write: if false; // No one can write to global content
    }
    
    // Analytics/usage data - only the user can access their own
    match /analytics/{userId}/{analyticsId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 